    {
      "parameters": {
        "jsCode": "const items=$input.all();const totalSucceeded=items.filter(i=>i.json.status==='Sent').length;const totalFailed=items.filter(i=>i.json.status==='Failed').length;return [{json:{totalRecords:$('Prepare User Records').all().length,totalProcessed:items.length,totalSucceeded,totalFailed,batchSize:5,waitSeconds:2,note:'Emails were simulated via JSONPlaceholder; no actual messages sent.'}}];"
      },
