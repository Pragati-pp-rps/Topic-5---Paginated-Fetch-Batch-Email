    {
      "parameters": {
        "jsCode": "return $input.all().map(item=>{const x=item.json;const ok=!!x.id&&!x.error;return {json:{status:ok?'Sent':'Failed',responseId:x.id??null,error:ok?'':String(x.error?.message??x.message??'Missing response ID')}};});"
